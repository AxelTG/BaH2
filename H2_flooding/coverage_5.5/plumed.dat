# vim: ft=plumed
#RESTART
UNITS LENGTH=A TIME=0.001  #Amstroeng, kJ/mol, fs

Htot: GROUP ATOMS=5,6,7,8,9,10,11,12,17,18,19,20,21,22,23,24,89,90,91,92,93,94,95,96,101,102,103,104,105,106,107,108,172,173,174,175,176,177,178,179,184,185,186,187,188,189,190,191,256,257,258,259,260,261,262,263,268,269,270,271,272,273,274,275,340,341,342,343,344,345,346,347,352,353,354,355,356,357,358,359,423,424,425,426,427,428,429,430,435,436,437,438,439,440,441,442,507,508,509,510,511,512,513,514,519,520,521,522,523,524,525,526,591,592,593,594,595,596,597,598,603,604,605,606,607,608,609,610,675,676,677,678,679,680,681,682,687,688,689,690,691,692,693,694
# remove H atoms of NH.
H: GROUP ATOMS=Htot REMOVE=250,82

a: FIXEDATOM AT=0,0,47.5

dHH: DISTANCES GROUP=H MIN={BETA=20.0}
cHH: COORDINATIONNUMBER SPECIES=H R_0=1.5 NN=6 MM=12 MAX={BETA=0.05}

dz: ZDISTANCES GROUPA=a GROUPB=H MAX={BETA=0.05}

target1: CUSTOM ARG=cHH.max FUNC=step(x-0.8) PERIODIC=NO

OPES_METAD ...
   LABEL=opes1
   ARG=cHH.max
   FILE=Kernels1.data
   TEMP=700
   PACE=250
   BARRIER=70
   RESTART=NO
   EXCLUDED_REGION=target1
... OPES_METAD

COMMITTOR ...
   ARG=dz.max
   STRIDE=1000
   BASIN_LL1=6.0
   BASIN_UL1=15.0
   FILE=FORMATION
... COMMITTOR

PRINT ARG=* STRIDE=10 FILE=COLVAR
FLUSH STRIDE=1
