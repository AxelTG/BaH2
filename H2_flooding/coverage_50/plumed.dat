# vim: ft=plumed
#RESTART
UNITS LENGTH=A TIME=0.001  #Amstroeng, kJ/mol, fs

Htot: GROUP ATOMS=25,26,27,28,37,38,39,40,49,50,51,52,61,62,63,64,72,73,74,75,107,108,109,110,118,119,120,121,128,129,130,131,140,141,142,143,152,153,154,155,188,189,190,191,200,201,202,203,212,213,214,215,224,225,226,227,235,236,237,238,270,271,272,273,282,283,284,285,293,294,295,296,305,306,307,308,315,316,317,318,351,352,353,354,363,364,365,366,375,376,377,378,387,388,389,390,399,400,401,402,435,436,437,438,447,448,449,450,459,460,461,462,471,472,473,474,483,484,485,486,519,520,521,522,531,532,533,534,542,543,544,545,554,555,556,557,566,567,568,569,602,603,604,605,613,614,615,616,624,625,626,627,635,636,637,638,647,648,649,650,683,684,685,686,695,696,697,698,707,708,709,710,718,719,720,721,729,730,731,732
# Remove H of NH:
H: GROUP ATOMS=Htot REMOVE=755,745,752,748,742,,744,750,741,754,739,756,740,749,746,747,752,751,743

dHH: DISTANCES GROUP=H MIN={BETA=20.0}
cHH: COORDINATIONNUMBER SPECIES=H R_0=1.5 NN=6 MM=12 MAX={BETA=0.05}

a: FIXEDATOM AT=0,0,47.5

dz: ZDISTANCES GROUPA=a GROUPB=H MAX={BETA=0.05}

target1: CUSTOM ARG=cHH.max FUNC=step(x-0.8) PERIODIC=NO

OPES_METAD ...
   LABEL=opes1
   ARG=cHH.max
   FILE=Kernels1.data
   TEMP=700
   PACE=250
   BARRIER=60
   #ADAPTIVE_SIGMA_STRIDE=5001
   RESTART=NO
   EXCLUDED_REGION=target1
... OPES_METAD

COMMITTOR ...
   ARG=dz.max
   STRIDE=1000
   BASIN_LL1=6.0
   BASIN_UL1=15.0
   FILE=FORMATION
... COMMITTOR

PRINT ARG=* STRIDE=10 FILE=COLVAR
FLUSH STRIDE=1
