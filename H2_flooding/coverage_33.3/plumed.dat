# vim: ft=plumed
#RESTART
UNITS LENGTH=A TIME=0.001  #Amstroeng, kJ/mol, fs

Htot: GROUP ATOMS=25,26,27,28,37,38,39,40,49,50,51,52,61,62,63,64,72,73,74,75,108,109,110,111,119,120,121,122,131,132,133,134,143,144,145,146,155,156,157,158,191,192,193,194,203,204,205,206,215,216,217,218,227,228,229,230,238,239,240,241,273,274,275,276,285,286,287,288,297,298,299,300,309,310,311,312,320,321,322,323,356,357,358,359,368,369,370,371,380,381,382,383,392,393,394,395,404,405,406,407,440,441,442,443,452,453,454,455,464,465,466,467,476,477,478,479,488,489,490,491,524,525,526,527,536,537,538,539,548,549,550,551,560,561,562,563,572,573,574,575,608,609,610,611,619,620,621,622,631,632,633,634,642,643,644,645,654,655,656,657,690,691,692,693,702,703,704,705,714,715,716,717,725,726,727,728,737,738,739,740
# Remove H of NH.
H: GROUP ATOMS=

a: FIXEDATOM AT=0,0,47.5

dHH: DISTANCES GROUP=H MIN={BETA=20.0}
cHH: COORDINATIONNUMBER SPECIES=H R_0=1.5 NN=6 MM=12 MAX={BETA=0.05}

dz: ZDISTANCES GROUPA=a GROUPB=H MAX={BETA=0.05}

target1: CUSTOM ARG=cHH.max FUNC=step(x-0.8) PERIODIC=NO

OPES_METAD ...
   LABEL=opes1
   ARG=cHH.max
   FILE=Kernels1.data
   TEMP=700
   PACE=250
   BARRIER=60
   #ADAPTIVE_SIGMA_STRIDE=5001
   RESTART=NO
   EXCLUDED_REGION=target1
... OPES_METAD

COMMITTOR ...
   ARG=dz.max
   STRIDE=1000
   BASIN_LL1=6.0
   BASIN_UL1=15.0
   FILE=FORMATION
... COMMITTOR

PRINT ARG=* STRIDE=10 FILE=COLVAR
FLUSH STRIDE=1
