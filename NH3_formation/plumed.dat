# vim: ft=plumed
#RESTART
UNITS LENGTH=A TIME=0.001  #Amstroeng, kJ/mol, fs

N2: GROUP ATOMS=755,756
Hr: GROUP ATOMS=759,760

c: COORDINATIONNUMBER SPECIESA=N2 SPECIESB=Hr R_0=2.0 NN=6 MM=12 MAX={BETA=0.05}

dNH: DISTANCES GROUPA=N2 GROUPB=Hr MIN={BETA=20.0}
dNH1: DISTANCES GROUPA=756 GROUPB=Hr MIN={BETA=20.0} MAX={BETA=0.05}

dHH: DISTANCES GROUP=Hr MIN={BETA=20.0}

uwall1: UPPER_WALLS ARG=dNH1.max AT=5.0 KAPPA=200 EXP=2.0

target1: CUSTOM ARG=dNH.min FUNC=step(2-x) PERIODIC=NO
  
OPES_METAD ...
   LABEL=opes1
   ARG=dNH1.min
   FILE=Kernels1.data
   TEMP=550
   PACE=200
   BARRIER=40
   RESTART=NO
   EXCLUDED_REGION=target1
... OPES_METAD

COMMITTOR ...
  ARG=dNH1.min
  STRIDE=5000
  BASIN_LL1=0.0
  BASIN_UL1=1.1
... COMMITTOR


PRINT ARG=* STRIDE=10 FILE=COLVAR
FLUSH STRIDE=1
