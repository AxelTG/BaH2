variable        NSTEPS1         equal 900000000
variable        DUMP_FREQ       equal 2000
variable        DUMP_FREQ1      equal 2000
variable        TEMP            equal 700
variable	      SEED1           equal 42771
variable	      SEED2           equal 54489 
variable        TAU_T           equal 0.05
variable        TAU_P           equal 0.25
variable        potential_path  string /path/to/graphs

units           metal
boundary        p p f

restart 200000 lmp.restart
atom_style      atomic
neigh_modify    delay 10 every 1

#read_restart   lmp.restart.40800000
read_data     data.lmp
mass          1 137.327
mass          2 2.014
region	      1 block INF INF INF INF INF 35.0
group         bottom region 1
group         atoms1 subtract all bottom


pair_style deepmd ${potential_path}/graph-1.pb 
pair_coeff * *

# COMPUTE

# TIMESTEP
timestep	0.0005  #ps 
thermo          ${DUMP_FREQ}
thermo_style    custom step temp pe ke etotal density press vol
thermo_modify   flush yes

# DUMP
dump            myDump all xyz ${DUMP_FREQ1} dump.0.xyz
dump_modify     myDump append yes element Ba H
#dump            myDump3 all atom ${DUMP_FREQ1} dump.lammpstrj
#dump_modify     myDump3 append yes


# run- NVT
#velocity        all create ${TEMP} ${SEED2} dist gaussian
fix             2 atoms1 nve
fix             3 atoms1 temp/csvr ${TEMP} ${TEMP} ${TAU_T} ${SEED2}
run             ${NSTEPS1}
